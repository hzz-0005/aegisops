AEGISOPS_PROFILE=dev
AEGISOPS_DATABASE_URL=postgresql+psycopg://aegisops:aegisops_dev_only@localhost:5432/aegisops
AEGISOPS_OTEL_ENABLED=false
AEGISOPS_ALERT_WEBHOOK_TOKEN=aegisops_dev_only
AEGISOPS_REQUEST_EVENT_SERVICE_TOKENS={"order-service":"aegisops_order_request_dev_only","lab-gateway":"aegisops_gateway_request_dev_only","inventory-service":"aegisops_inventory_request_dev_only","payment-service":"aegisops_payment_request_dev_only"}
AEGISOPS_OPERATOR_TOKEN=aegisops_operator_dev_only
AEGISOPS_APPROVER_TOKEN=aegisops_approver_dev_only
AEGISOPS_RABBITMQ_URL=amqp://aegisops:aegisops_dev_only@localhost:5672/
AEGISOPS_TEMPORAL_ADDRESS=127.0.0.1:7233
AEGISOPS_TEMPORAL_NAMESPACE=default
AEGISOPS_PROMETHEUS_URL=http://127.0.0.1:9090
AEGISOPS_LOKI_URL=http://127.0.0.1:3100
AEGISOPS_TEMPO_URL=http://127.0.0.1:3200
AEGISOPS_INVESTIGATION_TOOL_TIMEOUT_SECONDS=5
# Compose workflow worker defaults to the bounded agent; false selects the rule baseline.
AEGISOPS_INVESTIGATION_AGENT_ENABLED=true
AEGISOPS_INVESTIGATION_AGENT_SECONDS=90
AEGISOPS_INVESTIGATION_AGENT_MODEL_CALLS=4
AEGISOPS_INVESTIGATION_AGENT_TOOL_CALLS=8
AEGISOPS_OPA_URL=http://127.0.0.1:8181
AEGISOPS_REMEDIATION_KILL_SWITCH=true
AEGISOPS_LAB_PAYMENT_URL=http://127.0.0.1:8002
AEGISOPS_LAB_ORDER_URL=http://127.0.0.1:8003
# Read-only investigation and optional commentary. Keep the API key local.
# AEGISOPS_LLM_BASE_URL=https://api.openai.com/v1
# AEGISOPS_LLM_MODEL=<model>
# AEGISOPS_LLM_API_KEY=<secret>
# AEGISOPS_LLM_MAX_TOKENS_PARAMETER=max_tokens
# AEGISOPS_LLM_RESPONSE_FORMAT=json_object
# AEGISOPS_LLM_THINKING_MODE=default
# AEGISOPS_LLM_MAX_OUTPUT_TOKENS=500
