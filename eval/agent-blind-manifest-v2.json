{
  "version": "agent-blind-manifest-v2",
  "frozen_at": "2026-10-25",
  "extends": "agent-blind-manifest-v1.json",
  "protocol_note": "Same protocol as v1 (truth separated, neutral alert, post-hoc scoring, unknown never correct). v2 adds four unfamiliar mechanisms and requires >=2 repeats per case before aggregate claims; the harness prints one eval file per invocation and repeats are separate files.",
  "protocol": {
    "ground_truth_separation": "Truth below is read only by the harness that injects faults and scores reports afterwards; the agent receives a constant neutral alert (service, name, summary) and never sees this file, fault names, case ids or truth.",
    "alert": {
      "alert_name": "OperationalObservation",
      "summary": "业务请求需要只读调查",
      "header": "X-Aegisops-Console: lab-console-v1"
    },
    "scoring": {
      "localisation_correct": "A backend-verified claim (OBSERVATION_VERIFIED) references the injected root service as claim.service or claim.dependency.",
      "mechanism_exact": "A verified claim additionally matches one of the frozen mechanism_exact_claims; cases with an empty list can be localised but never mechanism-exact.",
      "unknown_not_correct": "Reports without a verified claim score UNKNOWN, never correct.",
      "wrong": "A verified claim that references neither the root service nor its failure interface scores WRONG.",
      "control_false_positive": "The quiet control scores FALSE_POSITIVE if any claim is verified or confidence>0; a clean inconclusive finish scores CORRECT.",
      "chance_baseline": "Chance@1 is mean(1/len(plausible_root_services)) over fault cases; Lift = exact_localisation_accuracy / Chance@1.",
      "scope_limited": "Cases with scope_limited=true have a truth outside the read-only tool scope; expected honest outcome is UNKNOWN without a wrong claim."
    }
  },
  "plausible_root_services_order_alert": [
    "order-service",
    "inventory-service",
    "orders-postgres",
    "payment-service",
    "lab-gateway"
  ],
  "plausible_root_services_payment_alert": [
    "payment-service",
